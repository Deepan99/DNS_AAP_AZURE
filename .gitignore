# .gitignore

# Hidden Vagrant-directory
.vagrant

# Backup files (e.g. Vim, Gedit, etc.)
*~

# Vagrant base boxes (you never know when someone puts one in the repository)
*.box

# Python artefacts
.ropeproject
*.pyc

# Ignore test directory
tests/
vagrant-tests/
docker-tests/

# Ignore editor directories
/.idea
/.vscode

# Ignore Ansible fact cache
.cache/

# Ansible / AAP local files and credentials
artifacts/
collections/ansible_collections/
*.retry
*.vault
vault_password*
.env

# Python tooling
.venv/
__pycache__/
